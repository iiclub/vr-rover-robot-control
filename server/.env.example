# HTTP port the local server listens on (ngrok will tunnel this port for the Quest)
PORT=8080

# NodeMCU robot's LAN address, e.g. ws://192.168.1.50:81 or ws://robot.local:81
ROBOT_WS_URL=ws://robot.local:81

# Shared secret the Quest client must send to open a control connection.
# Anyone with the ngrok URL + this token can drive the robot -- keep it private.
CONTROL_TOKEN=change-me

# Milliseconds since the last control message before the server force-stops the robot.
CONTROL_STALE_MS=250
