# Shared secret both phone.html?token=... and quest.html?token=... must send to use
# the /api/signal handshake endpoint. Anyone with this token (and your Vercel URL)
# can pair with your phone/robot -- keep it private. Set this in the Vercel project's
# environment variables (not just here) before deploying.
SIGNAL_TOKEN=change-me

# Populated automatically by `vercel env pull` once an Upstash Redis store (Storage
# -> Marketplace -> Upstash) is connected to the project in the Vercel dashboard.
# Depending on the integration version this shows up as either pair below --
# web/api/signal.js checks both.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
